# ==========================================
# ZENITH STORE - VARIABLES D'ENVIRONNEMENT (EXEMPLE)
# ==========================================

# Port et environnement
PORT=3000
NODE_ENV=production

# URL publique de votre boutique en ligne (ex: https://zenith-store.onrender.com)
SITE_URL=https://votre-site.onrender.com

# Sécurité Administrateur (Mot de passe pour déverrouiller admin.html)
ADMIN_PASSWORD=VotreMotDePasseAdmin2026!
SESSION_SECRET=remplacez_par_une_phrase_secrete_aleatoire_tres_longue

# Clés Stripe (dashboard.stripe.com) pour encaisser les paiements
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AliExpress Open Platform (optionnel si import par scraping actif)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# Base de données MongoDB Atlas Cloud (gratuit jusqu'à 512 MB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/zenith_store?retryWrites=true&w=majority
